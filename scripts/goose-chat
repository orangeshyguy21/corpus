#!/usr/bin/env bash
# goose-chat — launch a project-scoped goose session for the corpus-admin
# MCP profile (dev/decisions.md, chunk 1).
#
# WHY THIS EXISTS
#   Chat transcripts carry finding material (the corpus-read/… tools return
#   store content). goose stores sessions in a SQLite DB under its default
#   data dir (~/.local/share/goose/sessions/); that would leak finding
#   material outside the project scope. goose exposes NO session-dir-only
#   override; the supported mechanism for relocating session storage is
#   GOOSE_PATH_ROOT, which reroutes goose's ENTIRE config+data+state tree
#   under one root. We point it at <store>/projects/<slug>/var/chat/, so the
#   sessions DB lands at <store>/projects/<slug>/var/chat/data/sessions/.
#
#   Because GOOSE_PATH_ROOT also reroutes config, the scope carries its own
#   config.yaml (provider + corpus-admin extension + developer-off). This
#   script provisions it deterministically rather than relying on a copy of
#   the host's ~/.config/goose/config.yaml.
#
# USAGE
#   scripts/goose-chat [goose args...]
#     The project scope is CORPUS_PROJECT (defaults to "default"; the app and
#     CLI use the same knob). ALL positional args pass through to goose, so
#     the normal goose CLI/run flags work unchanged.
#   Examples:
#     scripts/goose-chat                        # session on project "default"
#     scripts/goose-chat -n ops                 # session named ops
#     CORPUS_PROJECT=pentest scripts/goose-chat run -t "list projects"
#     scripts/goose-chat info -v                # verify the scope wiring
#
# The global ~/.config/goose/config.yaml must declare the corpus-admin
# extension and disable the developer (shell) extension; this scope's
# config mirrors those settings here so a chat can never reach bash.

set -euo pipefail

# --- resolve project scope ---------------------------------------------------
# No default project: an unset CORPUS_PROJECT used to resolve to the project
# literally named "default", so a chat could administer the wrong store
# scope and look like it worked.
slug="${CORPUS_PROJECT:?set CORPUS_PROJECT to the project this chat administers}"

# Must match corpus-core's paths.rs: CORPUS_STORE, else <CORPUS_HOME>/store,
# else ~/.corpus/store. Chat scopes are siblings of the store (var/chat/),
# NOT inside the project subtree — a launched agent can read its own project
# tree, and these transcripts range over every project.
data_root="${CORPUS_HOME:-$HOME/.corpus}"
store_root="${CORPUS_STORE:-$data_root/store}"
scope="$(dirname "$store_root")/var/chat/$slug"
mkdir -p "$scope/config"
# sessions.db lives under $scope/data/sessions (created by goose on first run)

# --- provision the scope's own config.yaml (deterministic) ------------------
corpus_mcp="${CORPUS_MCP:-$(cd "$(dirname "$0")/.." && pwd)/target/debug/corpus-mcp}"
cat > "$scope/config/config.yaml" <<YAML
GOOSE_INPUT_LIMIT: 32768
active_provider: ollama
providers:
  ollama:
    enabled: true
    model: qwen3.6:35b
    configured: true

# corpus-admin: the host-side store-admin MCP profile (dev/decisions.md,
# chunk 1): the SAME corpus-mcp binary behind --admin. The sandbox-facing
# profile never enables this. `developer` (bash + file edit) is disabled so
# the chat admin can only reach the store through the typed admin tools.
extensions:
  corpus-admin:
    type: stdio
    name: corpus-admin
    enabled: true
    cmd: $corpus_mcp
    args: ["--admin"]
    envs: {}
    timeout: 300
  developer:
    enabled: false
    type: platform
    name: developer
YAML

GOOSE_PATH_ROOT="$scope" exec goose "$@"
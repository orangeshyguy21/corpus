/target
# macOS Finder metadata.
.DS_Store
# The corpus store lives OUTSIDE this repo now — `~/.corpus` (CORPUS_HOME),
# with run dirs and chat scopes as siblings of the store. That is what puts
# an opencode run's cwd outside any git repo, so it cannot discover this
# repo's `.opencode/` or read `benchmarks/`. Nothing under `store/` should
# ever come back; this guard is for strays.
/store
# Test-run artifacts under corpus-app: the management chat writes its scoped
# goose config/session tree to a store/ path relative to CARGO_MANIFEST_DIR
# during integration/live runs. It is never source; ignore it wholesale.
/crates/corpus-app/store/
# Working plans, notes, and scratch — local to each developer.
/dev
# cdk-regtest plugin runtime state: sandbox evidence and compiled tools.
/plugins/cdk-regtest/evidence
/plugins/cdk-regtest/tools/cdk-cli
# corpus-faucet: source is committed (faucet-src/), the build output is not.
/plugins/cdk-regtest/corpus-faucet
/plugins/cdk-regtest/faucet-src/target
# Pinned source cache (derived data, content-addressed). The SHAs live in
# sources.toml (committed); the trees themselves are fetched host-side.
/sources
